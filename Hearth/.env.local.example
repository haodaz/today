# 复制成 .env.local 后填入。.env.local 已被 git 忽略，不会进仓库。
# 只需要填你实际拿到的那一个，其余留空。

# Nebius Token Factory —— https://dev.nebius.com/builders
NEBIUS_API_KEY=

# 阿里 DashScope（通义）
DASHSCOPE_API_KEY=

# OpenRouter（一个 key 打通多家，适合横向比模型）
OPENROUTER_API_KEY=

# AWS Bedrock 走 ~/.aws/credentials 或下面两个，用于 AWS Builder mini challenge
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
