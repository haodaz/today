{
  "expo": {
    "name": "Today",
    "slug": "today",
    "version": "0.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.today.tv"
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "showVerboseWarnings": false
        }
      ],
      "expo-localization"
    ]
  }
}
